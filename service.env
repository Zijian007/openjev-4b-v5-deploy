# ==============================================================================
# OpenJev 4B v5 服务运行环境配置 (service.env)
# 优先级说明：命令行前置环境变量 > 本文件配置 > 代码默认兜底
# ==============================================================================

# 1. 硬件与显卡配置 (GPU Device ID)
# 指定服务使用的物理 GPU 编号（当前系统 GPU 0/1/2 负载高，默认绑定 GPU 3）
OPENJEV_GPU=3

# 2. 网络监听配置 (Network Binding)
# 服务监听端口 (默认 31000)
OPENJEV_PORT=31000
# 监听网络接口 (0.0.0.0 允许局域网/机器人域控访问，127.0.0.1 仅限本机访问)
OPENJEV_BIND_HOST=0.0.0.0

# 3. 运维生命周期与健康超时 (Lifecycle & Health Timeouts)
# 服务启动并等待模型加载就绪的最大等待秒数 (默认 180 秒)
OPENJEV_START_TIMEOUT=180
# 服务停止时的优雅退出等待秒数 (超过则强制 kill, 默认 10 秒)
OPENJEV_STOP_TIMEOUT=10

# 4. 推理请求保护超时 (Inference Watchdogs)
# 单次推理在 GPU 计算子进程中的最长超时秒数 (防死锁, 默认 180 秒)
OPENJEV_REQUEST_TIMEOUT=180
# 请求在排队等待队列中的最大超时秒数 (默认 30 秒)
OPENJEV_QUEUE_TIMEOUT=30
